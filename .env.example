# PoolAIssistant - Root environment file (single source of truth)
#
# Copy this to .env (at the repo root) and fill in real values.
# .env is gitignored. NEVER commit secrets.
#
# Components read this via:
#   - Python (brain/, scripts/): python-dotenv with load_dotenv() walks up
#     from cwd to find this file
#   - PHP deploy folders (web-portal/*_deploy/, ai-assistant/php/): keep
#     their own .env at deploy time (FTP'd to server). Treat those as
#     MIRRORED FROM ROOT — when you rotate creds here, also update the
#     deploy folders before next FTP push. (See scripts/consolidate_env.py
#     for the source-of-truth merge logic.)

# --- Shared infrastructure (Hostinger MySQL) ---
DB_HOST=localhost
DB_NAME=u931726538_PoolAIssistant
DB_USER=u931726538_xxx
DB_PASS=fill_me_in

# --- Shared infrastructure (Hostinger FTP/SFTP) ---
SFTP_HOST=ftp.modprojects.co.uk
SFTP_PORT=21
SFTP_USER=u931726538.xxx
SFTP_PASSWORD=fill_me_in
SFTP_CHUNKS_PATH=/data/chunks

# --- FTP for web-portal deploy.py (manually exported, not loaded from .env) ---
# These three env vars must be exported in the shell before running deploy.py
# or pi-software's publish_update.py. They are NOT loaded from .env.
#
#   POOLAI_FTP_HOST     ftp.modprojects.co.uk
#   POOLAI_FTP_USER     u931726538.mbs              (chroot lands on poolai.*)
#   POOLAI_FTP_PASS     <password>
#
# For the admin-domain deploy target (admin.modprojects.co.uk), set these
# additional vars *if* the new subdomain has its own FTP user (its own chroot).
# If it shares the u931726538.mbs chroot, leave these unset and use
# ftp_base_subdir in deploy.manifest.json instead.
#   POOLAI_ADMIN_FTP_HOST   ftp.modprojects.co.uk
#   POOLAI_ADMIN_FTP_USER   u931726538.admin     (or whatever you create in hPanel)
#   POOLAI_ADMIN_FTP_PASS   <password>

# --- Shared API / secrets ---
ANTHROPIC_API_KEY=sk-ant-...
BOOTSTRAP_SECRET=hex_token_64_chars
JWT_SECRET=hex_token_64_chars
ALERT_EMAIL=alerts@example.com
SMTP_FROM=PoolDash Alerts <alerts@example.com>

# Consumer key for analytics callers hitting /api/list_chunks.php and
# /api/chunks_status.php. Issued from the consumer_keys MySQL table —
# see web-portal/database/README_consumer_keys.md for setup. Brain is
# FTP-only by default; this is only needed if the optional HTTP path is
# wired in (see B2 in brain/IMPROVEMENTS.md).
# CONSUMER_KEY=hex_token_64_chars

# --- Brain-specific (analytics consumer) ---
# API_URL/API_KEY are deprecated since brain switched to FTP-only sync.
API_URL=https://poolaissistant.modprojects.co.uk
OUTPUT_DIR=./output
LOCAL_CHUNKS_DIR=./data/chunks
CHUNK_SIZE=1000
DELETE_AFTER_DOWNLOAD=true
CLEANUP_AFTER_MERGE=true
# Optional allowlist; leave unset to auto-discover all device dirs
# DEVICE_IDS=2,5
# Pipeline staleness threshold in hours; sync exits non-zero past this
STALENESS_HOURS=6
# Comma-separated chunk-filename prefixes to skip at merge time (e.g. test data)
SKIP_DATE_PREFIXES=2020-01-,2020-02-
# A Pi without a heartbeat in this many hours is treated as offline (C3).
# Set higher if your Pis heartbeat infrequently (default 2h covers a normal cron interval).
HEARTBEAT_OFFLINE_HOURS=2

# --- Web-portal / AI-assistant PHP runtime config ---
SESSION_NAME=mod_admin_session
SESSION_LIFETIME=3600
MAX_UPLOAD_SIZE=52428800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
DEBUG_MODE=false
