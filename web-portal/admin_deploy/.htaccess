# PoolAIssistant Admin domain - admin.modprojects.co.uk
# Hosts admin UI + admin-only API. Same-origin between the two.

# Redirect bare domain to admin dashboard
RewriteEngine On
RewriteRule ^$ /admin/ [R=301,L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to .env and config bootstrap
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
