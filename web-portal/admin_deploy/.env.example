# PoolAIssistant PHP Configuration
# Copy this file to .env and fill in your values

# Database Configuration (required)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Session Configuration
SESSION_NAME=mod_admin_session
SESSION_LIFETIME=3600

# Upload limits (bytes)
MAX_UPLOAD_SIZE=52428800

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Alert Configuration
ALERT_EMAIL=admin@example.com
SMTP_FROM="PoolDash Alerts <alerts@example.com>"

# Device Provisioning Secret (generate a secure random string)
BOOTSTRAP_SECRET=your_bootstrap_secret_here

# Debug Mode (set to true only in development)
DEBUG_MODE=false
