# Environment: development or production
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-secret-to-a-long-random-string
ADMIN_EMAIL=client@example.com
ADMIN_PASSWORD=password123
BOOTSTRAP_SECRET=replace-with-strong-shared-secret
DATABASE_URL=postgres://user:password@host:5432/pooldash_portal
PGSSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PoolDash <no-reply@pooldash.example.com>
APP_BASE_URL=https://portal.example.com
RETENTION_DAYS=90
# Alert email for device failures (leave blank to disable)
ALERT_EMAIL=
