# PoolAIssistant Kiosk Mode
# This file should be copied to /home/poolaissistant/.config/labwc/autostart

pkill -f pcmanfm-pi 2>/dev/null
pkill -f wf-panel-pi 2>/dev/null

swaybg -c '#000000' &

# Screen must never sleep: kill any idle daemon raspi-config may have added,
# and force the display output on every 4 minutes in case anything blanks it.
pkill swayidle 2>/dev/null
( while :; do wlopm --on '*' 2>/dev/null; sleep 240; done ) &

# Apply screen rotation from saved settings
ROTATION=$(python3 -c "import json; print(json.load(open('/opt/PoolAIssistant/data/pooldash_settings.json')).get('screen_rotation', 0))" 2>/dev/null || echo 0)
case "$ROTATION" in
    90)  TRANSFORM="90" ;;
    180) TRANSFORM="180" ;;
    270) TRANSFORM="270" ;;
    *)   TRANSFORM="normal" ;;
esac
sleep 2
wlr-randr --output DSI-2 --transform "$TRANSFORM" 2>/dev/null &

# Device-scale-factor for the kiosk browser - compensates for high-DPI panels
# (e.g. the 10" official touchscreen, ~226dpi) so touch targets stay a
# comparable physical size to the 7" screen (~132dpi) the UI was tuned for.
# Defaults to 1.0 (no scaling) so existing 7" units are unaffected.
# Unlike the ROTATION read above, this value isn't funneled through a `case`
# with a safe catch-all, so the bounds check (matching persist.py's
# 0.5-4 range) happens inline here - this is the only place that would
# otherwise pass a raw JSON value straight to Chromium's command line, and
# this file has no UI to keep it correct at the source (chromium_scale_factor
# has no settings-page route; it's set by hand-editing pooldash_settings.json).
SCALE=$(python3 -c "
import json
try:
    v = float(json.load(open('/opt/PoolAIssistant/data/pooldash_settings.json')).get('chromium_scale_factor', 1.0))
except Exception:
    v = 1.0
print(v if 0.5 <= v <= 4 else 1.0)
" 2>/dev/null || echo 1.0)

sleep 3

# Clear stale Chromium lock files (prevents startup failure after crash/reboot)
rm -f ~/.config/chromium/SingletonLock ~/.config/chromium/SingletonSocket ~/.config/chromium/SingletonCookie 2>/dev/null

# Chromium kiosk - Flask runs on port 80
# lwrespawn restarts the browser if it ever crashes; without it a dead browser
# leaves the black swaybg background - which looks exactly like a sleeping screen.
/usr/bin/lwrespawn /usr/bin/chromium --noerrdialogs --disable-infobars --kiosk --incognito \
  --ozone-platform=wayland --password-store=basic \
  --touch-events=enabled \
  --enable-touch-drag-drop \
  --force-device-scale-factor="$SCALE" \
  http://localhost &
